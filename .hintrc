{
  "extends": ["development"],
  "browserslist": ["defaults", "not ie 11", "not chrome <= 109"],
  "hints": {
    "disown-opener": [
      "error",
      {
        "includeSameOriginURLs": true,
      },
    ],
    "no-inline-styles": [
      "warning",
      {
        "requireNoStyleElement": true,
      },
    ],
  },
}
